<Project Sdk="Microsoft.NET.Sdk">
  <!-- DucklingService.exe: the Windows service (LocalSystem) that holds the device state, installs app packages,
       applies the kiosk, joins Wi-Fi and updates Duckling. The shell reaches it over the DucklingTablet pipe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DucklingService</AssemblyName>
    <RootNamespace>Duckling.Service</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Duckling.Core\Duckling.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Duckling.Tests" />
  </ItemGroup>
</Project>
