<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The Home pill, shown only while an allowed website is open in place of the home screen. -->
    <TextView
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/pill"
        android:text="@string/home"
        android:textColor="#1E2A33"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Shown beside Home when the website asked for a video from a host it is not allowed; it opens the parent area
         (behind the PIN) at the list of refused hosts, where a parent can allow one. -->
    <TextView
        android:id="@+id/video_blocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="132dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/pill"
        android:text="@string/video_blocked"
        android:textColor="#8A2A12"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
