# Duckling Tablet backend settings. Copy to /opt/duckling/.env on the droplet (chmod 600). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://api.ducklingtablet.com
PORTAL_URL=https://parents.ducklingtablet.com
APP_URL=https://app.ducklingtablet.com

# PostgreSQL (DigitalOcean Managed Database duckling-pg, private host, sslmode=require). Make both roles once with
# DATABASE_URL_ADMIN='postgresql://doadmin:...@private-host:25060/duckling?sslmode=require' node dist/bootstrap.js,
# which prints these two lines. Then node dist/migrate.js.
DATABASE_URL_APP=
DATABASE_URL_SYSTEM=
DATABASE_CA_CERT=/opt/duckling/ca-certificate.crt

# Long random values: openssl rand -base64 48
SESSION_SECRET=
ADMIN_TOKEN=
# Parent emails (comma-separated) that see the Stats page in the portal: counts across every family.
STATS_EMAILS=

# DigitalOcean Spaces (bucket duckling in NYC3 with the CDN on; no custom domain, see the build plan's decision log)
STORAGE=s3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=duckling
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://duckling.nyc3.cdn.digitaloceanspaces.com

# Email for parent sign-in links: SendGrid (ducklingtablet.com is an authenticated domain there). SMTP_PASS is a
# Mail Send API key made in the SendGrid console. Port 2525 because DigitalOcean blocks outbound 25, 465 and 587.
# Empty SMTP_HOST logs the link instead (development).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM=Duckling Tablet <hello@ducklingtablet.com>

# Azure Speech: resource duckling-speech (Standard S0, East US) in the duckling-tablet resource group
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
NARRATOR_VOICE=en-US-AnaNeural
TTS_DAILY_CHARS_PER_DEVICE=20000

# Push to tablets after a parent change (FCM HTTP v1). A Firebase service account key (JSON) saved on the droplet,
# for example /opt/duckling/fcm-service-account.json, owned root:duckling mode 640 (the deploy script sets this).
# Empty: tablets check in every three hours instead.
FCM_SERVICE_ACCOUNT_FILE=

# ET Ducky ticket bridge for app requests
ETDUCKY_API_URL=
ETDUCKY_API_KEY=
ETDUCKY_WEBHOOK_SECRET=

# Free trial for a new family, in days, no card. Subscriptions take over at its end once the stores are wired in (A3).
TRIAL_DAYS=7

# Store review family. Reviewers cannot read our email, so this one address signs in on the tablet with this fixed
# six-digit code and gets no mail. Set both only in production, give them to the store consoles as the reviewer's
# username and password, and change both when a review is over. Leave empty to turn the review sign-in off.
REVIEW_EMAIL=
REVIEW_CODE=

# Anthropic (workspace Duckling Tablet, $50 per month limit): drawing lessons and story scenes go through
# POST /ai/messages with the device token; the server adds the key. Calls per device per app per day; * is any other app.
ANTHROPIC_API_KEY=
AI_DAILY_CALLS=draw-with-me:25,story-maker:12,*:10
AI_MODELS=claude-haiku-5-5,claude-sonnet-5-5
AI_DEFAULT_MODEL=claude-haiku-5-5
