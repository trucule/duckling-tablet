# Duckling Tablet backend settings. Copy to /opt/duckling/.env on the droplet (chmod 600). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://api.ducklingtablet.com
PORTAL_URL=https://parents.ducklingtablet.com
APP_URL=https://app.ducklingtablet.com

# PostgreSQL (DigitalOcean Managed Database duckling-pg, private host, sslmode=require). Make both roles once with
# DATABASE_URL_ADMIN='postgresql://doadmin:...@private-host:25060/duckling?sslmode=require' node dist/bootstrap.js,
# which prints these two lines. Then node dist/migrate.js.
DATABASE_URL_APP=
DATABASE_URL_SYSTEM=
DATABASE_CA_CERT=/opt/duckling/ca-certificate.crt

# Long random values: openssl rand -base64 48
SESSION_SECRET=
ADMIN_TOKEN=

# DigitalOcean Spaces (bucket duckling in NYC3 with the CDN on; no custom domain, see the build plan's decision log)
STORAGE=s3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=duckling
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://duckling.nyc3.cdn.digitaloceanspaces.com

# Email for parent sign-in links: SendGrid (ducklingtablet.com is an authenticated domain there). SMTP_PASS is a
# Mail Send API key made in the SendGrid console. Empty SMTP_HOST logs the link instead (development).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM=Duckling Tablet <hello@ducklingtablet.com>

# Azure Speech: resource duckling-speech (Standard S0, East US) in the duckling-tablet resource group
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
NARRATOR_VOICE=en-US-AnaNeural
TTS_DAILY_CHARS_PER_DEVICE=20000

# ET Ducky ticket bridge for app requests
ETDUCKY_API_URL=
ETDUCKY_API_KEY=
ETDUCKY_WEBHOOK_SECRET=
