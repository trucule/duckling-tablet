# Duckling Tablet backend settings. Copy to /opt/duckling/.env on the droplet (chmod 600). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://api.ducklingtablet.com
PORTAL_URL=https://parents.ducklingtablet.com
APP_URL=https://app.ducklingtablet.com
DATABASE_PATH=/opt/duckling/data/duckling.db

# Long random values: openssl rand -base64 48
SESSION_SECRET=
ADMIN_TOKEN=

# DigitalOcean Spaces (bucket with the CDN on, custom domain cdn.ducklingtablet.com)
STORAGE=s3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=duckling
SPACES_KEY=
SPACES_SECRET=
CDN_URL=https://cdn.ducklingtablet.com

# Email for parent sign-in links (any SMTP provider). Empty SMTP_HOST logs the link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Duckling Tablet <hello@ducklingtablet.com>

# Azure Speech (a resource for the product, separate from Scarlett's tablet key)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2
NARRATOR_VOICE=en-US-AnaNeural
TTS_DAILY_CHARS_PER_DEVICE=20000

# ET Ducky ticket bridge for app requests
ETDUCKY_API_URL=
ETDUCKY_API_KEY=
ETDUCKY_WEBHOOK_SECRET=
